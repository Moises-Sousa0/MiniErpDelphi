unit DAO.Caixa;

interface
uses
  System.SysUtils, System.Classes, uDMConexao, Model.Caixa, FireDAC.Comp.Client;

type
  TCaixaDao = class
  private
  public
    function BuscarCaixaAberto(): TCaixa;
    procedure AbrirCaixa(Caixa: TCaixa);
  end;

implementation

function TCaixaDao.BuscarCaixaAberto(): TCaixa;

var
Qry: TFDQuery;

begin
  Result := Nil;

  Qry := TFDQuery.Create(nil);
  try
    Qry.Connection := DmConexao.FDConexao;
    Qry.SQL.Text := 'SELECT id, operador_id, data_abertura, data_fechamento, valor_abertura, valor_fechamento, status FROM caixa' + ' WHERE status = ''ABERTO'';';
    Qry.Open;

    if not Qry.Eof then
    begin
      Result := TCaixa.Create;
      Result.Id := Qry.FieldByName('id').AsInteger;
      Result.OperadorId := Qry.FieldByName('operador_id').AsInteger;
      Result.DataAbertura := Qry.FieldByName('data_abertura').AsDateTime;
      Result.ValorAbertura := Qry.FieldByName('valor_abertura').AsCurrency;
      Result.DataFechamento := Qry.FieldByName('data_fechamento').AsDateTime;
      Result.ValorFechamento := Qry.FieldByName('valor_fechamento').AsCurrency;
      Result.Status := Qry.FieldByName('status').AsString = 'ABERTO';
    end;

  finally
    Qry.Free;
  end;
end;

procedure TCaixaDao.AbrirCaixa(Caixa: TCaixa);
var
Qry: TFDQuery;

begin
  Result := Nil;

  Qry := TFDQuery.Create(nil);
  try
    Qry.Connection := DmConexao.FDConexao;
    Qry.SQL.Text := 'SELECT id, operador_id, data_abertura, data_fechamento, valor_abertura, valor_fechamentom, status FROM caixa' + ' WHERE status = ''ABERTO'';';
    Qry.ExecSQL;

    Result.

  finally

  end;
end;

end.
